{
    "folders": [
        {
            "path": "../",
            "name": "💈 theseus front"
        }
    ],

    "extensions": {
        "recommendations": [
            "bierner.lit-html",
            "local.sql-in-strings"
        ]
    },

    "settings": {

        "files.exclude": {
            ".git"        : true,
            ".github"     : true,
            "node_modules": true,
            "dist"        : true,
        },

        "explorer.fileNesting.patterns": {
            "package.json":  ".env*, .git*, .editor*, *rc, *.json, .*.yml, *.config.js, *.config.ts",
        },
    }
}

