{
    "name"       : "theseus-front",
    "version"    : "0.2.0",
    "description": "theseus client",
    "repository" : "github:4apaev/theseus-front",
    "type"       : "module",

    "scripts": {
        "start"   : "vite --host 0.0.0.0",
        "dev"     : "vite --host 0.0.0.0",
        "build"   : "tsc --noEmit && vite build",
        "preview" : "vite preview --host 0.0.0.0",
        "tsc"     : "tsc --noEmit",
        "lint"    : "eslint . --fix",
        "test"    : "node --test test/*.test.ts",
        "screens" : "playwright test",
        "check"   : "npm run lint && npm run test && npm run build && npm run screens",
        "sync"    : "sh scripts/sync.sh"
    },
    "dependencies": {
        "lit"   : "^3.3.3",
        "three" : "^0.186.1",
        "garage": "github:4apaev/garage"
    },
    "devDependencies": {
        "vite"                    : "^8.3.5",
        "@playwright/test"        : "^1.64.1",
        "@gltf-transform/cli"     : "^4.5.1",
        "globals"                 : "^17.13.0",
        "eslint"                  : "^10.13.0",
        "@eslint/js"              : "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "typescript-eslint"       : "^8.72.0",
        "@types/three"            : "^0.186.0",
        "@types/node"             : "^26.6.5"
    }
}