{
    "name"       : "theseus-front",
    "version"    : "0.1.0",
    "description": "procedural theseus flight and port prototype",
    "repository" : "github:4apaev/theseus-front",
    "type"       : "module",
    "engines"    : { "node": ">=24" },

    "scripts": {
        "dev"    : "vite --host 0.0.0.0",
        "build"  : "tsc --noEmit && vite build",
        "preview": "vite preview --host 0.0.0.0",
        "tsc"    : "tsc --noEmit",
        "lint"   : "eslint .",
        "lint:fix": "eslint . --fix",
        "test"   : "node --test test/*.test.ts",
        "check"  : "npm run lint && npm run test && npm run build"
    },

    "dependencies": {
        "lit"  : "^3.3.3",
        "three": "^0.186.0"
    },

    "devDependencies": {
        "vite"             : "^8.3.0",
        "globals"          : "^17.12.0",
        "eslint"           : "^10.10.0",
        "@eslint/js"       : "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "typescript-eslint": "^8.70.0",
        "typescript"       : "~6.0.3",
        "@types/three"     : "^0.186.0",
        "@types/node"      : "^24.13.4"
    }
}
